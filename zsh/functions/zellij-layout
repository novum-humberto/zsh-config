# zellij-layout
# ================================================================
# Gestión de layouts de Zellij.
#
# Menú con 2 opciones:
#   1. Exportar el layout de la sesión actual a un archivo .kdl
#   2. Cargar un layout guardado (lanza zellij con él)
#
# Los layouts viven en ~/.config/zellij/layouts/*.kdl
#
# Uso:  zellij-layout
# ================================================================

zellij-layout() {
    local LAYOUT_DIR="$HOME/.config/zellij/layouts"

    # Colores
    local GREEN='\033[0;32m'
    local RED='\033[0;31m'
    local YELLOW='\033[0;33m'
    local CYAN='\033[0;36m'
    local NC='\033[0m'

    # Verificar/crear directorio de layouts
    if [[ ! -d "$LAYOUT_DIR" ]]; then
        mkdir -p "$LAYOUT_DIR"
        echo -e "${YELLOW}Directorio de layouts creado: $LAYOUT_DIR${NC}"
    fi

    # Banner simple
    echo ""
    echo -e "${CYAN}=================================================${NC}"
    echo -e "${CYAN}        Gestión de Layouts de Zellij             ${NC}"
    echo -e "${CYAN}=================================================${NC}"
    echo ""

    echo "1. Exportar layout actual"
    echo "2. Cargar layout guardado"
    echo "3. Salir"
    echo ""

    echo -ne "${YELLOW}Elige una opción [1-3]: ${NC}"
    read -r choice

    case "$choice" in
        1)
            # Verificar que estamos dentro de una sesión de Zellij
            if [[ -z "$ZELLIJ" ]]; then
                echo -e "${RED}No estás dentro de una sesión de Zellij.${NC}"
                echo "Ejecuta este comando desde una sesión activa."
                return 1
            fi

            echo -ne "${YELLOW}Nombre del layout (sin extensión): ${NC}"
            read -r name
            [[ -z "$name" ]] && { echo -e "${RED}Nombre vacío.${NC}"; return 1; }

            local file="$LAYOUT_DIR/${name}.kdl"
            echo -e "${GREEN}Exportando layout...${NC}"
            zellij action dump-layout > "$file"

            if [[ -f "$file" ]]; then
                # Corregir el archivo: Zellij a veces pone start_suspended=true,
                # que hace que los paneles no se vean al cargar el layout.
                sed -i 's/start_suspended true/start_suspended false/g' "$file"
                echo -e "${GREEN}Layout exportado y corregido: $file${NC}"
                echo -e "${YELLOW}Tip: si el panel 4 dice 'zellij action dump-layout',${NC}"
                echo -e "${YELLOW}edítalo y cambia 'command=\"zellij\"' por 'command=\"zsh\"'.${NC}"
            fi
            ;;
        2)
            # Selector interactivo de layouts
            local layouts=("$LAYOUT_DIR"/*.kdl)

            if [[ ! -e "${layouts[1]}" ]]; then
                echo -e "${RED}No hay layouts guardados en $LAYOUT_DIR${NC}"
                echo -e "${YELLOW}Usa la opción 1 para exportar tu primer layout.${NC}"
                return 1
            fi

            echo -e "${CYAN}Layouts disponibles:${NC}"
            local i=1
            for layout in "${layouts[@]}"; do
                [[ ! -e "$layout" ]] && continue
                local lname
                lname=$(basename "$layout" .kdl)
                echo -e "  ${GREEN}$i)${NC} $lname"
                ((i++))
            done
            local max_idx=$((i - 1))
            echo -e "${YELLOW}0) Volver al menú${NC}"

            echo -ne "\n${GREEN}Selecciona un número: ${NC}"
            read -r idx

            if [[ "$idx" == "0" ]]; then
                return 0
            fi

            if ! [[ "$idx" =~ ^[0-9]+$ ]] || (( idx < 1 || idx > max_idx )); then
                echo -e "${RED}Selección inválida.${NC}"
                return 1
            fi

            local selected_file="${layouts[$idx]}"
            local layout_name
            layout_name=$(basename "$selected_file" .kdl)
            echo -e "${GREEN}Cargando layout: $layout_name${NC}"
            zellij --layout "$selected_file"
            ;;
        3)
            echo "Saliendo..."
            ;;
        *)
            echo -e "${RED}Opción inválida${NC}"
            ;;
    esac
}
