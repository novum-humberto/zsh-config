# menu-principal
# ================================================================
# Menú por secciones para las funciones del sistema.
#
# PARA AÑADIR UNA FUNCIÓN NUEVA:
#   1. Abre este archivo.
#   2. Baja al bloque "DATOS".
#   3. Añade UNA línea en `funciones` con el formato:
#        [seccion.item]="descripción|nombre-función"
#      Si la función pide un argumento, añade un tercer campo:
#        [seccion.item]="descripción|nombre-función|prompt del argumento"
#
#   Si quieres una sección nueva:
#   1. Añade una línea en `secciones`:
#        [N]="emoji Título de la sección"
#   2. Añade sus funciones en `funciones` con claves [N.1], [N.2]...
#
#   Nada más. La lógica de navegación no hay que tocarla.
#
# NAVEGACIÓN:
#   Menú principal → sección → función → vuelve al submenú.
#   "0" en cualquier nivel: subir un nivel (o salir desde el principal).
#
# USO:   menu-principal
# ALIAS: menu (en 95-func-shortcuts.sh)
# ================================================================

menu-principal() {
    # --- Colores ---
    local -r RED='\033[0;31m'
    local -r GREEN='\033[0;32m'
    local -r YELLOW='\033[1;33m'
    local -r CYAN='\033[0;36m'
    local -r PURPLE='\033[0;35m'
    local -r BOLD='\033[1m'
    local -r NC='\033[0m'

    # ============================================================
    # DATOS — edita solo este bloque para añadir secciones/funciones
    # ============================================================
    local -A secciones=(
        [1]="🔧 Sistema y mantenimiento"
        [2]="🔐 Seguridad"
        [3]="📁 Gestión de archivos"
        [4]="🛠️  Herramientas"
    )

    # Formato: [sec.item]="descripción|función"  o
    #          [sec.item]="descripción|función|prompt del argumento"
    local -A funciones=(
        [1.1]="🔧 Mantenimiento del sistema|mantenimiento"
        [1.2]="🩺 Suite-Watch (diagnóstico)|suite-watch"

        [2.1]="🔐 Cryptosith (cifrado por capas)|cryptosith"
        [2.2]="🔥 Gestor UFW (firewall)|ufw-manager"
        [2.3]="🦠 ClamAV (antivirus)|clamav-virus"
        [2.4]="🌐 VPN (gestor de conexiones)|vpn"

        [3.1]="🔗 Borrar enlaces simbólicos|rmsymlinks"
        [3.2]="🔎 Auditar enlaces rotos|checksymlinks"

        [4.1]="🧮 Calculadora BC|bc-calc"
        [4.2]="📐 Gestor de layouts Zellij|zellij-layout"
        [4.3]="🔍 Buscar en aliases|search-aliases|Palabra clave para buscar"
    )
    # ============================================================
    # FIN DATOS
    # ============================================================

    local opcion opc_sec clave i max_item desc resto fn prompt_text arg

    while true; do
        # ---------- Menú principal (categorías) ----------
        clear
        echo -e "${PURPLE}"
        echo "╔══════════════════════════════════════════════════════╗"
        echo "║             🧅 MENÚ PRINCIPAL — ZSH 🧅               ║"
        echo "║            Acceso por secciones                      ║"
        echo "╚══════════════════════════════════════════════════════╝"
        echo -e "${NC}"
        echo -e "${CYAN}Categorías:${NC}"
        echo ""
        for i in ${(ok)secciones}; do
            echo -e "  ${YELLOW}${i}${NC}  ${secciones[$i]}"
        done
        echo -e "  ${YELLOW}0${NC}  🚪 Salir"
        echo ""
        echo -ne "${GREEN}👉 Categoría: ${NC}"
        read -r opcion

        [[ "$opcion" == "0" ]] && {
            echo ""
            echo -e "${GREEN}👋 Hasta luego.${NC}"
            return 0
        }

        if [[ -z "${secciones[$opcion]:-}" ]]; then
            echo -e "${RED}✗ Opción inválida.${NC}"
            sleep 1
            continue
        fi

        # ---------- Submenú de la sección ----------
        while true; do
            clear
            echo -e "${PURPLE}══════════════════════════════════════════════════════${NC}"
            echo -e "${PURPLE}  ${BOLD}${secciones[$opcion]}${NC}"
            echo -e "${PURPLE}══════════════════════════════════════════════════════${NC}"
            echo ""

            # Máximo índice de ítem dentro de esta sección
            max_item=0
            for clave in ${(k)funciones}; do
                [[ $clave == ${opcion}.* ]] || continue
                i=${clave#*.}
                (( i > max_item )) && max_item=$i
            done

            # Listar las funciones de la sección en orden
            for ((i=1; i<=max_item; i++)); do
                clave="${opcion}.${i}"
                [[ -z "${funciones[$clave]:-}" ]] && continue
                desc="${funciones[$clave]%%|*}"
                echo -e "  ${YELLOW}${i}${NC}  ${desc}"
            done
            echo -e "  ${YELLOW}0${NC}  ← Volver al menú principal"
            echo ""
            echo -ne "${GREEN}👉 Opción: ${NC}"
            read -r opc_sec

            [[ "$opc_sec" == "0" ]] && break

            clave="${opcion}.${opc_sec}"
            if [[ -z "${funciones[$clave]:-}" ]]; then
                echo -e "${RED}✗ Opción inválida.${NC}"
                sleep 1
                continue
            fi

            # Extraer función y, si existe, prompt de argumento
            resto="${funciones[$clave]#*|}"
            fn="${resto%%|*}"
            if [[ "$resto" == *"|"* ]]; then
                prompt_text="${resto#*|}"
            else
                prompt_text=""
            fi

            echo ""
            echo -e "${CYAN}▶ Ejecutando: ${fn}${NC}"
            echo ""

            if [[ -n "$prompt_text" ]]; then
  		  echo -ne "${CYAN}${prompt_text}: ${NC}"
    		  read -r arg
    		  if [[ -z "$arg" ]]; then
        	     echo -e "${RED}✗ Cancelado (argumento vacío).${NC}"
    		  else
    		    "$fn" "$arg"
   		  fi
		else
    		    # Verificación especial: cryptosith es proyecto aparte
    		    if [[ "$fn" == "cryptosith" ]] && ! type cryptosith &>/dev/null; then
       		       echo -e "${YELLOW}⚠ cryptosith no está instalado.${NC}"
        	       echo -e "  Instálalo desde: ${CYAN}https://codeberg.org/novum-humberto/cryptosith${NC}"
    		else
        	    "$fn"
    	      fi
	fi

            echo ""
            echo -e "${CYAN}──────────────────────────────────────────────────────${NC}"
            echo -ne "${GREEN}[Enter] para volver al submenú...${NC}"
            read -r
        done
    done
}
