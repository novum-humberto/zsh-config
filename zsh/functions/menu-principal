# menu-principal
# ================================================================
# Menú centralizado que agrupa acceso rápido a las funciones
# principales del sistema.
#
# Diseño ORTOGONAL: cada opción llama a su función y vuelve al menú
# sin excepciones. Sin "return 0" que rompa el bucle.
#
# Opciones:
#   1. Mantenimiento del sistema
#   2. Cryptosith (cifrado)
#   3. Calculadora BC
#   4. Gestor de layouts Zellij
#   5. Buscar en aliases
#   6. Gestor UFW (firewall)
#   0. Salir
#
# Uso:  menu-principal
# Alias: menu (en 95-func-shortcuts.sh)
# ================================================================

menu-principal() {
    # --- Colores ---
    local -r RED='\033[0;31m'
    local -r GREEN='\033[0;32m'
    local -r YELLOW='\033[1;33m'
    local -r BLUE='\033[0;34m'
    local -r PURPLE='\033[0;35m'
    local -r CYAN='\033[0;36m'
    local -r BOLD='\033[1m'
    local -r NC='\033[0m'

    # --- Bucle principal ---
    while true; do
        clear
        echo -e "${PURPLE}"
        echo "╔══════════════════════════════════════════════════════╗"
        echo "║             🧅 MENÚ PRINCIPAL — ZSH 🧅               ║"
        echo "║         Acceso centralizado a funciones              ║"
        echo "╚══════════════════════════════════════════════════════╝"
        echo -e "${NC}"
        echo -e "${CYAN}Selecciona una función:${NC}"
        echo ""
        echo -e "  ${YELLOW}1${NC}  🔧 Mantenimiento del sistema"
        echo -e "  ${YELLOW}2${NC}  🔐 Cryptosith (cifrado por capas)"
        echo -e "  ${YELLOW}3${NC}  🧮 Calculadora BC"
        echo -e "  ${YELLOW}4${NC}  📐 Gestor de layouts Zellij"
        echo -e "  ${YELLOW}5${NC}  🔍 Buscar en aliases"
        echo -e "  ${YELLOW}6${NC}  🔥 Gestor UFW (firewall)"
        echo -e "  ${YELLOW}0${NC}  🚪 Salir"
        echo ""
        echo -ne "${GREEN}👉 Opción [0-6]: ${NC}"
        read -r opcion

        # --- Ejecutar opción ---
        case "$opcion" in
            1) mantenimiento ;;
            2) cryptosith ;;
            3) bc-calc ;;
            4) zellij-layout ;;
            5)
                echo ""
                echo -ne "${CYAN}🔍 Palabra clave para buscar en aliases: ${NC}"
                read -r keyword
                echo ""
                if [[ -n "$keyword" ]]; then
                    search-aliases "$keyword"
                else
                    echo -e "${RED}✗ Búsqueda cancelada (campo vacío).${NC}"
                fi
                ;;
            6) ufw-manager ;;
            0)
                echo ""
                echo -e "${GREEN}👋 Saliendo del menú. ¡Hasta luego!${NC}"
                return 0
                ;;
            *)
                echo ""
                echo -e "${RED}✗ Opción inválida. Intenta de nuevo.${NC}"
                sleep 1
                continue
                ;;
        esac

        # --- Pausa unificada (excepto si se salió) ---
        echo ""
        echo -e "${CYAN}──────────────────────────────────────────────────────${NC}"
        echo -ne "${GREEN}Presiona [Enter] para volver al menú principal...${NC}"
        read -r
    done
}
